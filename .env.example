# Copy these names into your local environment and provide real values there.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-secret
BETTER_AUTH_URL=http://localhost:3000
UNSPLASH_ACCESS_KEY=
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=replace-with-a-sender-on-your-verified-domain
# Development only: redirects verification and password-reset emails to this inbox when NODE_ENV=development.
RESEND_TEST_TO_EMAIL=your-controlled-test-inbox@example.com
# Local development only: set to "mailpit" to capture authentication email at http://127.0.0.1:8025.
# Mailpit mode sends to the actual synthetic account address and does not use RESEND_TEST_TO_EMAIL.
OPORA_EMAIL_TRANSPORT=
